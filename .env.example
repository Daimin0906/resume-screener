# ===== LLM（对话）=====
# 支持任何兼容 OpenAI 接口的服务（智谱 BigModel / OpenAI / 等）
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.7-flashx
LLM_TEMPERATURE=0.0

# ===== Embedding（向量化）=====
# 智谱 embedding-3 默认 2048 维（可设为 256~2048）
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=2048

# ===== 向后兼容：若 LLM_*/EMBEDDING_* 未设置，则回退到下面统一配置 =====
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 向量数据库 =====
# 后端选择：chroma（默认，本地持久化）/ milvus（Milvus/Zilliz Cloud）
VECTOR_DB=chroma
CHROMA_PERSIST_DIR=./chroma_db

# ===== Milvus / Zilliz Cloud（VECTOR_DB=milvus 时生效）=====
# 可直接提供完整 URI，或提供 HOST + PORT 自动拼接
# MILVUS_URI=https://your-instance.zillizcloud.com
MILVUS_HOST=https://your-instance.serverless.cloud.zilliz.com.cn
MILVUS_PORT=80
MILVUS_TOKEN=your-milvus-token
MILVUS_COLLECTION=resume_screening
# 索引类型：AUTOINDEX / IVF_FLAT / HNSW 等
INDEX=AUTOINDEX

# ===== 服务 / 跨域 =====
# 允许的前端来源（逗号分隔），留空则允许所有来源
SERVER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 邮箱抓取（IMAP）=====
# Gmail 需在设置中开启 IMAP，并使用「应用专用密码」（不是登录密码）
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SSL=true
IMAP_MAILBOX=INBOX
IMAP_MARK_READ=true
IMAP_ATTACHMENT_MAX_MB=10

# ===== 定时任务 =====
SCHEDULER_ENABLED=true
SCHEDULER_EMAIL_FETCH_INTERVAL_MINUTES=30
SCHEDULER_PRECLASSIFY_INTERVAL_MINUTES=60

# ===== 规则对比验证 =====
RULES_COMPARE_MAX_RESUMES=50

# ===== 并发 / 缓存 =====
# 上传异步处理（true=立即返回，后台线程池解析；false=同步等待）
UPLOAD_ASYNC=true
UPLOAD_MAX_WORKERS=8
ANALYZER_MAX_WORKERS=8
# 筛选结果缓存（键含规则版本，规则更新自动失效）
RESULTS_CACHE_ENABLED=true
RESULTS_CACHE_TTL_SECONDS=1800

# ===== 入库即预分类 =====
# 上传解析完成后，自动按当前规则做一次无岗位通用分类（仅列表/详情展示）
PRECLASSIFY_ON_INGEST=true

# ===== 缓存 / 日志 =====
CACHE_DIR=./cache
LOG_LEVEL=INFO
